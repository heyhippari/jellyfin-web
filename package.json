  "scripts": {
    "start": "npm run serve",
    "serve": "vite --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "build:development": "vite build --mode development --config vite.config.ts && vite build --mode development --config vite.themes.config.ts && npm run build:verify",
    "build:production": "vite build --mode production --config vite.config.ts && vite build --mode production --config vite.themes.config.ts && npm run build:verify",
    "build:verify": "node scripts/verify-vite-output.mjs && node scripts/verify-vite-csp.mjs && node scripts/smoke-build-subpath.mjs",
    "build:check": "tsc --noEmit",
    "build:es-check": "npm run build:production && npm run escheck",
    "escheck": "node scripts/select-vite-es5.mjs",
    "lint": "eslint",
    "test": "vitest --watch=false --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "stylelint": "stylelint \"src/**/*.{css,scss}\""
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0",
    "yarn": "YARN NO LONGER USED - use npm instead."
